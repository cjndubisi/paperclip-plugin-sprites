# Copy to .env and fill in. .env is gitignored — never commit a real token.
#
# Prefer the `pass` password store over this file: scripts/live-check.mjs reads
# `pass show cjndubisi/sprites/api-token` when SPRITES_TOKEN is unset, which
# keeps the credential encrypted at rest and out of shell history.
#
#   pass insert -m cjndubisi/sprites/api-token
#
# Mint a token with the Sprites CLI (or create one in the sprites.dev dashboard):
#   sprite login          # prints a token on first authentication
#
# Note: a Sprites token is NOT a flyctl token. A `fm2_…` macaroon from
# `fly auth token` is rejected by api.sprites.dev. The format here is
# org-slug/org-id/token-id/token-value.
#
# In production, prefer a Paperclip secret reference on the environment's
# `apiToken` field over a host-wide variable: the reference is scoped to one
# company and is never written to disk in plaintext.
SPRITES_TOKEN=

# Optional: override which pass entry the live check reads.
# SPRITES_TOKEN_PASS_PATH=cjndubisi/sprites/api-token
